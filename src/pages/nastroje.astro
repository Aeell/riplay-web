---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base
  title="Nástroje — písmo na dráhu | Riplay"
  description="Písmo na obrysy pro laser a frézku: SVG a DXF v milimetrech, vše v prohlížeči. Bez registrace, bez CDN, bez nahrávání na server."
>
  <section class="hero wrap">
    <p class="eyebrow">07 — nástroje · písmo</p>
    <h1 style="margin-top:18px">Písmo na <em>dráhu</em>.</h1>
    <p class="lead">
      Napiš text, vyber soubor s písmem a stáhni obrysy v milimetrech — SVG pro laser,
      DXF pro frézku. Počítá se to v tvém prohlížeči: písmo ani text nikam neodejde.
    </p>
    <div class="hero-meta mono">
      <span>1:1 v milimetrech</span><span>bez registrace</span><span>bez CDN</span><span>zdarma</span>
    </div>
  </section>

  <section class="sheet wrap" id="nastroj">
    <div class="sheet-head">
      <h2>Konvertor</h2>
      <span class="eyebrow">01 / písmo → cesty</span>
    </div>

    <div class="tool">
      <div class="tool-controls">
        <label class="field">
          <span>Text</span>
          <textarea id="f-text" rows="3" spellcheck="false">VERB</textarea>
        </label>

        <div class="pair">
          <label class="field">
            <span>Velikost (mm)</span>
            <input id="f-size" type="number" value="50" min="1" max="500" step="1" />
          </label>
          <label class="field">
            <span>Prostrkání (mm)</span>
            <input id="f-tracking" type="number" value="0" min="-20" max="50" step="0.1" />
          </label>
        </div>

        <div class="pair">
          <label class="field">
            <span>Výška řádku (×)</span>
            <input id="f-lh" type="number" value="1.2" min="0.5" max="3" step="0.05" />
          </label>
          <label class="field check">
            <input id="f-kerning" type="checkbox" checked />
            <span>Kerning</span>
          </label>
        </div>

        <label class="field">
          <span>Písmo (TTF / OTF)</span>
          <input id="f-font" type="file" accept=".ttf,.otf,font/ttf,font/otf" />
        </label>

        <p class="mono dim" id="f-font-state">vestavěné: Liberation Sans (OFL)</p>
        <button class="btn btn-quiet" id="f-reset" type="button">Zpět na vestavěné písmo</button>

        <p class="mono" id="f-error" role="status" aria-live="polite"></p>
      </div>

      <div class="tool-preview">
        <div id="f-preview" aria-live="polite"></div>
        <p class="mono dim" id="f-stats">načítám řez písma…</p>
      </div>
    </div>

    <div class="tool-actions">
      <button class="btn" id="b-svg" type="button">Stáhnout SVG</button>
      <button class="btn" id="b-dxf" type="button">Stáhnout DXF</button>
      <button class="btn btn-quiet" id="b-copy" type="button">Kopírovat SVG kód</button>
      <span class="mono dim" id="f-saved">velikost písma = výška em; obrysy jsou otevřené křivky, ne výplň</span>
    </div>
  </section>

  <section class="sheet wrap" id="co-neumi">
    <div class="sheet-head">
      <h2>Co to neumí</h2>
      <span class="eyebrow">02 / meze</span>
    </div>

    <div class="bench">
      <div class="bench-row"><b>Slučování obrysů</b><span class="svc">union</span><span class="state">ne — písmena jdou do souboru jako samostatné obrysy</span><i class="dot warn"></i></div>
      <div class="bench-row"><b>WOFF / WOFF2</b><span class="svc">formát</span><span class="state">ne — jen TTF a OTF, tedy to, co má frézkaře v počítači</span><i class="dot warn"></i></div>
      <div class="bench-row"><b>Google Fonts online</b><span class="svc">zdroj</span><span class="state">ne — žádné cizí požadavky, písmo si nahraješ</span><i class="dot ok"></i></div>
      <div class="bench-row"><b>Výplň / šrafování</b><span class="svc">CAM</span><span class="state">ne — tohle jsou dráhy, ne obrázek</span><i class="dot warn"></i></div>
    </div>

    <p class="dim" style="max-width:62ch;margin-top:22px">
      Vestavěný řez je Liberation Sans pod licencí SIL OFL 1.1 — licence je přiložená
      v souboru <span class="mono">/nastroje/LICENSE-liberation.txt</span>. Nahrané písmo
      zůstává v paměti prohlížeče do zavření stránky; nikam se neposílá.
    </p>

    <p class="mono dim" style="margin-top:14px;display:flex;align-items:center;gap:8px">
      <Icon name="cam" size={14} />
      DXF je R12 s uzavřenými POLYLINE v milimetrech ($INSUNITS = 4).
    </p>
  </section>
</Base>

<style>
  .tool {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }
  .tool-controls {
    background: var(--bg);
    padding: 22px 20px;
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .tool-preview {
    background: var(--panel);
    border-left: 1px solid var(--line-soft);
    padding: 20px;
    display: grid;
    gap: 12px;
    align-content: start;
    min-height: 220px;
  }
  .field { display: grid; gap: 6px; }
  .field > span {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dimmer);
  }
  .field input[type='number'],
  .field textarea,
  .field input[type='file'] {
    background: var(--panel-2);
    border: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 13px;
    padding: 9px 10px;
    width: 100%;
    resize: vertical;
  }
  .field input[type='number']:focus-visible,
  .field textarea:focus-visible,
  .field input[type='file']:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 1px;
  }
  .field input[type='checkbox'] { accent-color: var(--accent); width: 15px; height: 15px; }
  .field input[type='file']::file-selector-button {
    background: var(--panel);
    color: var(--ink);
    border: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    padding: 6px 10px;
    margin-right: 10px;
    cursor: pointer;
  }
  .field input[type='file']::file-selector-button:hover { border-color: var(--dim); }
  .field.check {
    display: flex;
    align-items: center;
    gap: 9px;
    align-self: end;
    padding-bottom: 10px;
  }
  .field.check span {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--dim);
    text-transform: none;
  }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .btn-quiet { border-color: var(--line); color: var(--dim); }
  .btn-quiet:hover { background: var(--line); color: var(--ink); }
  #f-error { color: var(--warn); min-height: 1em; margin: 0; }
  #f-preview { display: grid; place-items: center; min-height: 180px; }
  #f-preview svg { width: 100%; height: auto; max-height: 340px; }
  /* A 0.1 mm stroke is invisible at preview scale, so the preview strokes in pixels.
     These must be :global() — the SVG arrives through innerHTML, without Astro's
     scope attribute, so a scoped selector would never match it. */
  :global(#f-preview svg) { max-width: 100%; color: var(--ink); }
  :global(#f-preview svg path) {
    stroke: currentColor;
    stroke-width: 1.4px;
    vector-effect: non-scaling-stroke;
  }
  .tool-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
  }
  @media (max-width: 880px) {
    .tool { grid-template-columns: 1fr; }
    .tool-preview { border-left: 0; border-top: 1px solid var(--line-soft); }
    .pair { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  import * as opentypeModule from 'opentype.js';
  import { textToContours, toSvg, toDxf, bounds, pointCount, filename } from '../lib/font-geometry.mjs';

  const ot = opentypeModule.default ?? opentypeModule;
  const $ = (id) => document.getElementById(id);
  const BUILTIN = '/nastroje/liberation-sans.ttf';

  let font = null;
  let builtinFont = null;
  let output = { svg: '', dxf: '' };

  const number = (id, fallback) => {
    const value = parseFloat($(id).value);
    return Number.isFinite(value) ? value : fallback;
  };

  function render() {
    const text = $('f-text').value;
    if (!font) {
      $('f-stats').textContent = 'písmo se ještě načítá…';
      return;
    }
    try {
      const contours = textToContours(font, text, {
        size: Math.max(1, number('f-size', 50)),
        tracking: number('f-tracking', 0),
        lineHeight: Math.max(0.5, number('f-lh', 1.2)),
        kerning: $('f-kerning').checked,
      });
      output.svg = toSvg(contours);
      output.dxf = toDxf(contours);
      $('f-error').textContent = '';

      if (!contours.length) {
        $('f-preview').innerHTML = '<p class="mono dim">Napiš aspoň jedno písmeno.</p>';
        $('f-stats').textContent = '0 obrysů';
        return;
      }
      $('f-preview').innerHTML = output.svg;
      const b = bounds(contours);
      $('f-stats').textContent = `${b.width.toFixed(1)} × ${b.height.toFixed(1)} mm · ${contours.length} obrysů · ${pointCount(contours)} bodů`;
    } catch (error) {
      console.error(error);
      $('f-error').textContent = `Chyba: ${error.message}`;
    }
  }

  async function loadBuiltin() {
    $('f-stats').textContent = 'načítám řez písma…';
    const response = await fetch(BUILTIN);
    if (!response.ok) throw new Error(`vestavěné písmo se nepodařilo načíst (${response.status})`);
    builtinFont = ot.parse(await response.arrayBuffer());
    font = builtinFont;
    $('f-font-state').textContent = 'vestavěné: Liberation Sans (OFL)';
    render();
  }

  function download(extension) {
    const blob = new Blob([output[extension === 'svg' ? 'svg' : 'dxf']], {
      type: extension === 'svg' ? 'image/svg+xml' : 'application/dxf',
    });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = filename($('f-text').value, extension);
    link.click();
    URL.revokeObjectURL(url);
  }

  for (const id of ['f-text', 'f-size', 'f-tracking', 'f-lh']) {
    $(id).addEventListener('input', render);
  }
  $('f-kerning').addEventListener('change', render);

  $('f-font').addEventListener('change', async (event) => {
    const file = event.target.files?.[0];
    if (!file) return;
    try {
      const parsed = ot.parse(await file.arrayBuffer());
      font = parsed;
      $('f-font-state').textContent = `nahrané: ${file.name}`;
      $('f-error').textContent = '';
      render();
    } catch {
      font = builtinFont;
      $('f-font-state').textContent = 'vestavěné: Liberation Sans (OFL)';
      $('f-error').textContent = 'Tohle písmo nepřečtu — potřebuji TTF nebo OTF.';
      render();
    }
  });

  $('f-reset').addEventListener('click', () => {
    $('f-font').value = '';
    font = builtinFont;
    $('f-font-state').textContent = 'vestavěné: Liberation Sans (OFL)';
    $('f-error').textContent = '';
    render();
  });

  $('b-svg').addEventListener('click', () => download('svg'));
  $('b-dxf').addEventListener('click', () => download('dxf'));
  $('b-copy').addEventListener('click', async () => {
    await navigator.clipboard.writeText(output.svg);
    const button = $('b-copy');
    button.textContent = 'Zkopírováno';
    setTimeout(() => { button.textContent = 'Kopírovat SVG kód'; }, 1800);
  });

  loadBuiltin().catch((error) => {
    $('f-stats').textContent = 'písmo se nepodařilo načíst';
    $('f-error').textContent = error.message;
  });
</script>

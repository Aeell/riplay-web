---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base
  title="Nástroje — písmo na dráhu | Riplay"
  description="Celý Google Fonts bez klíče: napiš text, vyber písmo a stáhni obrysy v milimetrech jako SVG nebo DXF. Počítá se v prohlížeči, text nikam neodejde."
>
  <section class="hero wrap">
    <p class="eyebrow">07 — nástroje · písmo</p>
    <h1 style="margin-top:18px">Písmo na <em>dráhu</em>.</h1>
    <p class="lead">
      Napiš text, vyber písmo z celého Google Fonts nebo nahraj vlastní soubor a stáhni
      obrysy v milimetrech — SVG pro laser, DXF pro frézku. Text zůstává v prohlížeči.
      Písmo stahujeme my, ne tvoje stránka, takže nikam neposílá ani tvoji IP adresu.
    </p>
    <div class="hero-meta mono">
      <span>1:1 v milimetrech</span><span id="m-count">celý Google Fonts</span><span>bez klíče</span><span>zdarma</span>
    </div>
  </section>

  <section class="sheet wrap" id="nastroj">
    <div class="sheet-head">
      <h2>Konvertor</h2>
      <span class="eyebrow">01 / písmo → cesty</span>
    </div>

    <div class="tool">
      <div class="tool-controls">
        <label class="field">
          <span>Text</span>
          <textarea id="f-text" rows="3" spellcheck="false">VERB</textarea>
        </label>

        <div class="pair">
          <label class="field">
            <span>Velikost (mm)</span>
            <input id="f-size" type="number" value="50" min="1" max="500" step="1" />
          </label>
          <label class="field">
            <span>Prostrkání (mm)</span>
            <input id="f-tracking" type="number" value="0" min="-20" max="50" step="0.1" />
          </label>
        </div>

        <div class="pair">
          <label class="field">
            <span>Výška řádku (×)</span>
            <input id="f-lh" type="number" value="1.2" min="0.5" max="3" step="0.05" />
          </label>
          <label class="field check">
            <input id="f-kerning" type="checkbox" checked />
            <span>Kerning</span>
          </label>
        </div>

        <label class="field">
          <span>Písmo (Google Fonts)</span>
          <input
            id="f-family"
            type="text"
            list="gf-families"
            placeholder="začni psát — třeba Lobster"
            autocomplete="off"
            spellcheck="false"
          />
          <datalist id="gf-families"></datalist>
        </label>

        <div class="pair">
          <label class="field">
            <span>Řez</span>
            <select id="f-weight">
              <option value="400">400 — regular</option>
            </select>
          </label>
          <label class="field check">
            <input id="f-italic" type="checkbox" />
            <span>Kurzíva</span>
          </label>
        </div>

        <label class="field">
          <span>Nebo vlastní soubor (TTF / OTF)</span>
          <input id="f-font" type="file" accept=".ttf,.otf,font/ttf,font/otf" />
        </label>

        <p class="mono dim" id="f-font-state">vestavěné: Liberation Sans (OFL)</p>
        <button class="btn btn-quiet" id="f-reset" type="button">Zpět na vestavěné písmo</button>

        <p class="mono" id="f-error" role="status" aria-live="polite"></p>
      </div>

      <div class="tool-preview">
        <div id="f-preview" aria-live="polite"></div>
        <p class="mono dim" id="f-stats">načítám řez písma…</p>
      </div>
    </div>

    <div class="tool-actions">
      <button class="btn" id="b-svg" type="button">Stáhnout SVG</button>
      <button class="btn" id="b-dxf" type="button">Stáhnout DXF</button>
      <button class="btn btn-quiet" id="b-copy" type="button">Kopírovat SVG kód</button>
      <span class="mono dim" id="f-saved">velikost písma = výška em; obrysy jsou otevřené křivky, ne výplň</span>
    </div>
  </section>

  <section class="sheet wrap" id="co-neumi">
    <div class="sheet-head">
      <h2>Co to neumí</h2>
      <span class="eyebrow">02 / meze</span>
    </div>

    <div class="bench">
      <div class="bench-row"><b>Slučování obrysů</b><span class="svc">union</span><span class="state">ne — písmena jdou do souboru jako samostatné obrysy</span><i class="dot warn"></i></div>
      <div class="bench-row"><b>WOFF / WOFF2</b><span class="svc">formát</span><span class="state">ne — TTF a OTF; z Google dostáváš TTF, takže to stačí</span><i class="dot warn"></i></div>
      <div class="bench-row"><b>Cizí abecedy</b><span class="svc">abecedy</span><span class="state">ne — stahujeme jen latinku, kvůli velikosti</span><i class="dot warn"></i></div>
      <div class="bench-row"><b>Výplň / šrafování</b><span class="svc">CAM</span><span class="state">ne — tohle jsou dráhy, ne obrázek</span><i class="dot warn"></i></div>
    </div>

    <p class="dim" style="max-width:62ch;margin-top:22px">
      Řezy z Google Fonts zůstávají pod svými licencemi (OFL, Apache 2.0 a podobně) — my je
      jen stahujeme a převádíme na křivky. Hotový řez si prohlížeč uloží, takže přepínání
      mezi písmy, která jsi už zkusil, je okamžité i po zavření stránky. Vestavěný
      Liberation Sans (SIL OFL 1.1) je záloha, která funguje bez sítě; jeho licence leží
      v <span class="mono">/nastroje/LICENSE-liberation.txt</span>.
    </p>

    <p class="mono dim" style="margin-top:14px;display:flex;align-items:center;gap:8px">
      <Icon name="cam" size={14} />
      DXF je R12 s uzavřenými POLYLINE v milimetrech ($INSUNITS = 4).
    </p>

    <p class="mono dim" style="margin-top:8px;display:flex;align-items:center;gap:8px">
      <Icon name="cam" size={14} />
      Převod 3D souborů (STL / OBJ / PLY / GLB) najdeš v <a href="/nastroje/prevod/">druhém nástroji</a>.
    </p>
  </section>
</Base>

<style>
  .tool {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }
  .tool-controls {
    background: var(--bg);
    padding: 22px 20px;
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .tool-preview {
    background: var(--panel);
    border-left: 1px solid var(--line-soft);
    padding: 20px;
    display: grid;
    gap: 12px;
    align-content: start;
    min-height: 220px;
  }
  .field { display: grid; gap: 6px; }
  .field > span {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dimmer);
  }
  .field input[type='number'],
  .field input[type='text'],
  .field select,
  .field textarea,
  .field input[type='file'] {
    background: var(--panel-2);
    border: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 13px;
    padding: 9px 10px;
    width: 100%;
    resize: vertical;
  }
  .field select { appearance: none; background-image: none; cursor: pointer; }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 1px;
  }
  .field input[type='checkbox'] { accent-color: var(--accent); width: 15px; height: 15px; }
  .field input[type='file']::file-selector-button {
    background: var(--panel);
    color: var(--ink);
    border: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    padding: 6px 10px;
    margin-right: 10px;
    cursor: pointer;
  }
  .field input[type='file']::file-selector-button:hover { border-color: var(--dim); }
  .field.check {
    display: flex;
    align-items: center;
    gap: 9px;
    align-self: end;
    padding-bottom: 10px;
  }
  .field.check span {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--dim);
    text-transform: none;
  }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .btn-quiet { border-color: var(--line); color: var(--dim); }
  .btn-quiet:hover { background: var(--line); color: var(--ink); }
  #f-error { color: var(--warn); min-height: 1em; margin: 0; }
  #f-preview { display: grid; place-items: center; min-height: 180px; }
  #f-preview svg { width: 100%; height: auto; max-height: 340px; }
  /* A 0.1 mm stroke is invisible at preview scale, so the preview strokes in pixels.
     These must be :global() — the SVG arrives through innerHTML, without Astro's
     scope attribute, so a scoped selector would never match it. */
  :global(#f-preview svg) { max-width: 100%; color: var(--ink); }
  :global(#f-preview svg path) {
    stroke: currentColor;
    stroke-width: 1.4px;
    vector-effect: non-scaling-stroke;
  }
  .tool-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
  }
  @media (max-width: 880px) {
    .tool { grid-template-columns: 1fr; }
    .tool-preview { border-left: 0; border-top: 1px solid var(--line-soft); }
    .pair { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  import * as opentypeModule from 'opentype.js';
  import { textToContours, toSvg, toDxf, bounds, pointCount, filename } from '../lib/font-geometry.mjs';

  const ot = opentypeModule.default ?? opentypeModule;
  const $ = (id) => document.getElementById(id);
  const BUILTIN = '/nastroje/liberation-sans.ttf';
  const CATALOG = '/nastroje/google-fonts.json';
  const BUCKET = 'riplay-fonts-v1';

  const state = {
    font: null,
    builtin: null,
    output: { svg: '', dxf: '' },
    families: null, // [name, category, weights, italic][]
    byName: new Map(),
    parsed: new Map(), // key -> opentype font
    family: null, // the Google family currently chosen
    controller: null,
  };

  const number = (id, fallback) => {
    const value = parseFloat($(id).value);
    return Number.isFinite(value) ? value : fallback;
  };

  function render() {
    const text = $('f-text').value;
    if (!state.font) {
      $('f-stats').textContent = 'písmo se ještě načítá…';
      return;
    }
    try {
      const contours = textToContours(state.font, text, {
        size: Math.max(1, number('f-size', 50)),
        tracking: number('f-tracking', 0),
        lineHeight: Math.max(0.5, number('f-lh', 1.2)),
        kerning: $('f-kerning').checked,
      });
      state.output.svg = toSvg(contours);
      state.output.dxf = toDxf(contours);
      $('f-error').textContent = '';

      if (!contours.length) {
        $('f-preview').innerHTML = '<p class="mono dim">Napiš aspoň jedno písmeno.</p>';
        $('f-stats').textContent = '0 obrysů';
        return;
      }
      $('f-preview').innerHTML = state.output.svg;
      const b = bounds(contours);
      $('f-stats').textContent = `${b.width.toFixed(1)} × ${b.height.toFixed(1)} mm · ${contours.length} obrysů · ${pointCount(contours)} bodů`;
    } catch (error) {
      console.error(error);
      $('f-error').textContent = `Chyba: ${error.message}`;
    }
  }

  // --- catalogue -------------------------------------------------------------

  async function catalog() {
    if (state.families) return state.families;
    const response = await fetch(CATALOG);
    if (!response.ok) throw new Error(`katalog písem se nepodařilo načíst (${response.status})`);
    const { families } = await response.json();
    state.families = families;
    for (const entry of families) state.byName.set(entry[0].toLowerCase(), entry);

    const list = $('gf-families');
    const fragment = document.createDocumentFragment();
    for (const [family, category] of families) {
      const option = document.createElement('option');
      option.value = family;
      option.label = category;
      fragment.append(option);
    }
    list.append(fragment);
    $('m-count').textContent = `celý Google Fonts — ${families.length} rodin`;
    return families;
  }

  // The catalogue is ~35 KB gzipped; loading it on first touch keeps the page light.
  // A failed attempt resets the promise, so a later touch retries instead of being stuck.
  let catalogPromise = null;
  const ensureCatalog = () =>
    (catalogPromise ??= catalog().catch((error) => {
      catalogPromise = null;
      $('f-error').textContent = error.message;
      throw error;
    }));

  for (const type of ['focus', 'pointerdown', 'keydown']) {
    $('f-family').addEventListener(type, () => { ensureCatalog().catch(() => {}); }, { passive: true });
  }

  function fillWeights(entry, keep = false) {
    const select = $('f-weight');
    const previous = select.value;
    select.replaceChildren(
      ...entry[2].map((weight) => {
        const option = document.createElement('option');
        option.value = String(weight);
        option.textContent = weight === 400 ? '400 — regular' : String(weight);
        return option;
      }),
    );
    select.disabled = false;
    if (keep && entry[2].includes(Number(previous))) select.value = previous;
  }

  // --- fetching, with three layers of caching --------------------------------

  async function bytes(url, signal) {
    const key = new URL(url, location.href).href;
    let store = null;
    try {
      store = await caches.open(BUCKET);
    } catch {
      // No Cache API (private mode, old browser): the HTTP cache still does its job.
    }
    if (store) {
      const hit = await store.match(key);
      if (hit) return { buffer: await hit.arrayBuffer(), cached: true };
    }
    const response = await fetch(url, { signal });
    if (!response.ok) throw new Error(`písmo se nestáhlo (${response.status})`);
    if (store) await store.put(key, response.clone()).catch(() => {});
    return { buffer: await response.arrayBuffer(), cached: false };
  }

  async function loadFamily(family, weight, italic) {
    const key = `${family}|${weight}|${italic ? 1 : 0}`;
    const name = `${family} ${weight}${italic ? ' kurzíva' : ''}`;

    // A newer click wins: cancel the request the previous click started, so rapid
    // switching never leaves a slow font queued up in front of the one you want.
    state.controller?.abort();
    state.controller = new AbortController();
    const signal = state.controller.signal;

    if (state.parsed.has(key)) {
      state.font = state.parsed.get(key);
      $('f-font-state').textContent = `${name} — z mezipaměti`;
      render();
      return;
    }

    $('f-font-state').textContent = `${name} — stahuji…`;
    $('f-stats').textContent = 'stahuji řez písma…';
    try {
      const url = `/api/font?family=${encodeURIComponent(family)}&weight=${weight}${italic ? '&italic=1' : ''}`;
      const { buffer, cached } = await bytes(url, signal);
      if (signal.aborted) return;
      const parsed = ot.parse(buffer);
      state.parsed.set(key, parsed);
      state.font = parsed;
      $('f-font-state').textContent = `${name} — ${cached ? 'z mezipaměti prohlížeče' : 'staženo'}`;
      $('f-error').textContent = '';
      render();
    } catch (error) {
      if (error.name === 'AbortError') return;
      $('f-error').textContent = `${name}: ${error.message}${italic ? ' — tahle rodina možná kurzívu nemá, zkus to bez ní' : ''}`;
      $('f-stats').textContent = 'písmo se nepodařilo načíst';
    }
  }

  function chosen() {
    ensureCatalog().catch(() => {});
    const entry = state.byName.get($('f-family').value.trim().toLowerCase());
    if (!entry && state.families) {
      $('f-error').textContent = 'Tohle písmo v katalogu není — vyber ho ze seznamu.';
    }
    return entry;
  }

  // Typing a name and pressing Enter can beat the catalogue download; wait for it
  // instead of declaring a perfectly good font missing.
  async function pick() {
    try {
      await ensureCatalog();
    } catch {
      return;
    }
    const entry = chosen();
    if (!entry) return;
    $('f-error').textContent = '';
    if (entry[0] !== state.family) {
      state.family = entry[0];
      fillWeights(entry);
    }
    loadFamily(entry[0], Number($('f-weight').value), $('f-italic').checked);
  }

  $('f-family').addEventListener('change', pick);

  // Enter should just load it, and stopping on a complete name should load it without
  // a second gesture — waiting for a blur is what made the original feel slow.
  $('f-family').addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      pick();
    }
  });

  let typing = null;
  $('f-family').addEventListener('input', () => {
    clearTimeout(typing);
    typing = setTimeout(() => {
      if (state.byName.has($('f-family').value.trim().toLowerCase())) pick();
    }, 350);
  });
  $('f-weight').addEventListener('change', pick);
  $('f-italic').addEventListener('change', pick);

  // --- built-in and uploaded fonts -------------------------------------------

  async function loadBuiltin() {
    $('f-stats').textContent = 'načítám řez písma…';
    const response = await fetch(BUILTIN);
    if (!response.ok) throw new Error(`vestavěné písmo se nepodařilo načíst (${response.status})`);
    state.builtin = ot.parse(await response.arrayBuffer());
    state.font = state.builtin;
    $('f-font-state').textContent = 'vestavěné: Liberation Sans (OFL)';
    render();
  }

  $('f-font').addEventListener('change', async (event) => {
    const file = event.target.files?.[0];
    if (!file) return;
    try {
      state.controller?.abort();
      state.font = ot.parse(await file.arrayBuffer());
      $('f-font-state').textContent = `nahrané: ${file.name}`;
      $('f-error').textContent = '';
      render();
    } catch {
      state.font = state.builtin;
      $('f-font-state').textContent = 'vestavěné: Liberation Sans (OFL)';
      $('f-error').textContent = 'Tohle písmo nepřečtu — potřebuji TTF nebo OTF.';
      render();
    }
  });

  $('f-reset').addEventListener('click', () => {
    state.controller?.abort();
    $('f-font').value = '';
    $('f-family').value = '';
    state.font = state.builtin;
    $('f-font-state').textContent = 'vestavěné: Liberation Sans (OFL)';
    $('f-error').textContent = '';
    render();
  });

  // --- output ----------------------------------------------------------------

  function download(extension) {
    const blob = new Blob([state.output[extension]], {
      type: extension === 'svg' ? 'image/svg+xml' : 'application/dxf',
    });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = filename($('f-text').value, extension);
    link.click();
    URL.revokeObjectURL(url);
  }

  for (const id of ['f-text', 'f-size', 'f-tracking', 'f-lh']) {
    $(id).addEventListener('input', render);
  }
  $('f-kerning').addEventListener('change', render);

  $('b-svg').addEventListener('click', () => download('svg'));
  $('b-dxf').addEventListener('click', () => download('dxf'));
  $('b-copy').addEventListener('click', async () => {
    await navigator.clipboard.writeText(state.output.svg);
    const button = $('b-copy');
    button.textContent = 'Zkopírováno';
    setTimeout(() => { button.textContent = 'Kopírovat SVG kód'; }, 1800);
  });

  loadBuiltin().catch((error) => {
    $('f-stats').textContent = 'písmo se nepodařilo načíst';
    $('f-error').textContent = error.message;
  });
</script>

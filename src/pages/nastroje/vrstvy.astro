---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ToolpathViewer from '../../components/ToolpathViewer.astro';
import { webApplication } from '../../lib/seo';
---

<Base
  title="G-code viewer — náhled po vrstvách zdarma | Riplay"
  description="Otevři .gcode a přejížděj vrstvy: obrysy, výplň, rozměry a množství filamentu. Soubor se nikam nenahrává, čte se v prohlížeči."
  schema={[webApplication('G-code viewer', 'Náhled G-code po vrstvách: obrysy, výplň, rozměry a filament. Soubor se čte v prohlížeči.', '/nastroje/vrstvy/')]}
>
  <section class="hero wrap">
    <p class="eyebrow">09 — nástroje · g-code</p>
    <h1 style="margin-top:18px">Dráha, kterou si můžeš <em>přejet</em>.</h1>
    <p class="lead">
      Než pustíš materiál, podívej se, co soubor opravdu obsahuje. Přetáhni <b>.gcode</b> a jezdi
      po vrstvách — obrysy, výplň a rozměry. Soubor se nikam nenahrává, čte se v prohlížeči.
    </p>
    <div class="hero-meta mono">
      <span>G1 po vrstvách</span><span>obrysy vs. výplň</span><span>v milimetrech</span><span>zdarma</span>
    </div>
  </section>

  <section class="sheet wrap" id="nastroj">
    <div class="sheet-head">
      <div>
        <h2>Náhled vrstev</h2>
        <p class="mono dim" id="g-state">zatím žádný soubor</p>
      </div>
      <span class="eyebrow">01 / gcode → oko</span>
    </div>

    <div class="viewer" id="g-drop">
      <div class="controls">
        <label class="field">
          <span>Soubor (.gcode, .nc, .tap)</span>
          <input id="g-file" type="file" accept=".gcode,.gco,.nc,.tap,.txt" />
        </label>

        <div class="demo">
          <div class="demo-actions">
            <button class="btn btn-quiet" type="button" id="g-demo">Načíst ukázku</button>
            <button class="btn btn-quiet" type="button" id="g-demo-arcs">Načíst oblouky</button>
          </div>
          <p class="mono dim">
            <b>Ukázka ze sliceru:</b> destička 30 × 20 × 4 mm s otvorem Ø6 a lemem,
            13 vrstev po 0,3 mm. Dráhy jsou opravdové, ale <b>netisklo se</b> — a soubor je
            v dialektu Klipperu, na LinuxCNC ho teprve přepíše postprocesor. Můžeš si ho
            <a href="/vrstvy/ukazka.gcode" download>stáhnout</a> a otevřít ve svém. Oblouky
            v něm nejsou žádné, proto druhá ukázka.
          </p>
          <p class="mono dim">
            <b>Ukázka oblouků:</b> ručně psaný soubor, ne výřez ze sliceru — dvě vrstvy po
            0,3 mm, vše v milimetrech a v rovině G17, půdorys 70 × 15 mm. Vrstva 1: půlkruh
            r 10 se středem (10, 0), kružnice Ø 10 se středem (40, 0), čtvrtkruh r 10 zapsaný
            přes <span class="mono">R</span> se středem (60, 10). Vrstva 2: tytéž tvary o 0,5 mm
            menší — r 9,5, Ø 9 a r 9,5. Každý oblouk je v datech i na obrazovce kružnice:
            tětiva se od ní liší nejvýš o 0,02 mm. Nic z toho se netisklo; kromě drah tomu
            chybí lem, výplň i retrakce. Můžeš si ho
            <a href="/vrstvy/oblouky.gcode" download>stáhnout</a>.
          </p>
        </div>

        <p class="mono" id="g-error" role="status" aria-live="polite"></p>

        <dl class="readout" id="g-readout" hidden>
          <div><dt>vrstev</dt><dd id="r-layers">—</dd></div>
          <div><dt>drah v této vrstvě</dt><dd id="r-paths">—</dd></div>
          <div><dt>extruze celkem</dt><dd id="r-extrusion">—</dd></div>
          <div><dt>půdorys</dt><dd id="r-bounds">—</dd></div>
        </dl>

        <p class="mono dim" id="g-notes" hidden></p>
      </div>

      <div class="stage">
        <ToolpathViewer
          controls
          minHeight={460}
          hint="přetáhni .gcode sem — nebo si načti ukázku či oblouky"
        />
      </div>
    </div>
  </section>

  <section class="sheet wrap" id="co-neumi">
    <div class="sheet-head">
      <h2>Co to neumí</h2>
      <span class="eyebrow">02 / meze</span>
    </div>

    <div class="bench">
      <div class="bench-row"><b>3D náhled s otáčením</b><span class="svc">pohled</span><span class="state">ne — kreslí se půdorys jedné vrstvy; na „co pojede“ to stačí</span><i class="dot warn"></i></div>
      <div class="bench-row"><b>Oblouky G2/G3</b><span class="svc">dráha</span><span class="state">skutečné oblouky z I/J/K i R; tětiva se od oblouku liší nejvýš o 0,02 mm</span><i class="dot ok"></i></div>
      <div class="bench-row"><b>Palce G20</b><span class="svc">jednotky</span><span class="state">přepočítá na mm včetně středů oblouků a napíše to do poznámky</span><i class="dot ok"></i></div>
      <div class="bench-row"><b>Roviny G18/G19</b><span class="svc">oblouk</span><span class="state">spočítá v rovině souboru, ale kreslí průmět do XY — svislý oblouk je na půdorysu úsečka</span><i class="dot warn"></i></div>
      <div class="bench-row"><b>Simulace stroje</b><span class="svc">čas</span><span class="state">ne — žádné zrychlení, teplota ani tlak</span><i class="dot warn"></i></div>
      <div class="bench-row"><b>Soubor nad 40 MB</b><span class="svc">velikost</span><span class="state">odmítne — takový soubor patří do sliceru</span><i class="dot warn"></i></div>
    </div>

    <p class="dim" style="max-width:62ch;margin-top:22px">
      Náhled čte jen to, co je v souboru: <span class="mono">G0/G1</span> a
      <span class="mono">G2/G3</span>, změny <span class="mono">Z</span> a komentáře
      <span class="mono">;Shell</span> / <span class="mono">;Internal Infill</span>. Soubor bez
      komentářů se vykreslí jednou barvou — hádat, co je obrys, by bylo horší než to nevědět.
      Rozumí <span class="mono">G90/G91</span>, <span class="mono">M82/M83</span>,
      <span class="mono">G92</span>, jednotkám <span class="mono">G20/G21</span> i rovinám
      <span class="mono">G17/G18/G19</span>; extruzi počítá z přírůstku a retrakci do ní nepočítá.
      Oblouk je rozdělený na tětivy tak, aby se žádná od skutečného oblouku neodchýlila víc než
      o 0,02 mm — na průměru 50 mm to je 70 bodů. Kde soubor střed ani poloměr neudává, kreslí se
      přímka a nástroj to napíše.
    </p>

    <p class="mono dim" style="margin-top:14px;display:flex;align-items:center;gap:8px">
      <Icon name="cam" size={14} />
      Model na dráhu převede <a href="/nastroje/prevod/">převodník</a>, písmo <a href="/nastroje/">druhý nástroj</a>.
    </p>
  </section>
</Base>

<script>
  import { parseGcode } from '../../lib/gcode.mjs';
  import type { ToolpathViewerElement } from '../../lib/toolpath-viewer';

  const MAX_BYTES = 40 * 1024 * 1024;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  const fileInput = $<HTMLInputElement>('g-file');
  const drop = $<HTMLElement>('g-drop');
  const error = $<HTMLElement>('g-error');
  const readout = $<HTMLElement>('g-readout');
  const notes = $<HTMLElement>('g-notes');
  const viewer = document.querySelector<ToolpathViewerElement>('toolpath-viewer');

  // Millimetres are the whole point here: a 108.36 mm part must not read as "108".
  const fmt = (n: number) => (Number.isFinite(n) ? n.toFixed(2) : '—');
  const setText = (id: string, value: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  };

  /** What the reader could not do with this file, in the reader's own words. */
  function caveatOf(stats: ReturnType<typeof parseGcode>['stats']) {
    if (stats.truncated) return 'soubor je moc dlouhý — načtena jen část';
    if (stats.unsupported.length) return `pozor: ${stats.unsupported.join(' · ')}`;
    if (stats.layerSource === 'z') {
      return 'soubor nemá značky vrstev — hranice jsou odhadnuté ze Z, z-hop je může posunout';
    }
    return '';
  }

  function load(name: string, text: string) {
    if (error) error.textContent = '';
    const result = parseGcode(text);
    if (!result.layers.length) {
      // Whatever was on screen belonged to another file: clear it rather than leave a picture
      // that no longer matches what the user just picked.
      viewer?.setLayers([]);
      readout?.setAttribute('hidden', '');
      setText('g-state', `${name} · nic k nakreslení`);
      if (error) error.textContent = 'v souboru nejsou žádné dráhy G0/G1 se souřadnicemi';
      return;
    }

    viewer?.setLayers(result.layers, result.bounds);

    setText('g-state', `${name} · ${result.stats.lines.toLocaleString('cs-CZ')} řádků`);
    readout?.removeAttribute('hidden');
    setText('r-layers', String(result.stats.layers));
    setText('r-extrusion', `${Math.round(result.stats.extrusion).toLocaleString('cs-CZ')} mm`);
    setText('r-bounds', result.bounds ? `${fmt(result.bounds.width)} × ${fmt(result.bounds.height)} mm` : '—');

    if (notes) {
      notes.textContent = caveatOf(result.stats);
      notes.hidden = !notes.textContent;
    }
  }

  // The viewer owns the layer; the readout follows it.
  viewer?.addEventListener('layerchange', (event) => {
    const { layer } = (event as CustomEvent<{ layer: { paths: unknown[] } }>).detail;
    setText('r-paths', String(layer.paths.length));
  });

  function handleFile(file: File) {
    if (file.size > MAX_BYTES) {
      if (error) error.textContent = `soubor má ${(file.size / 1048576).toFixed(1)} MB, limit je 40 MB`;
      return;
    }
    file.text().then((text) => load(file.name, text)).catch(() => {
      if (error) error.textContent = 'soubor se nepodařilo přečíst';
    });
  }

  fileInput?.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) handleFile(file);
  });

  // A tool that opens empty is a tool nobody tries. Both samples ship as files (not baked into
  // the page), are labelled as demos, and are fetched only when asked for.
  async function loadSample(button: HTMLButtonElement, path: string) {
    button.disabled = true;
    if (error) error.textContent = '';
    try {
      const response = await fetch(path);
      if (!response.ok) throw new Error(String(response.status));
      load(path.split('/').pop() ?? path, await response.text());
    } catch {
      if (error) error.textContent = 'ukázku se nepodařilo načíst — přetáhni si vlastní soubor';
    } finally {
      button.disabled = false;
    }
  }

  for (const [id, path] of [['g-demo', '/vrstvy/ukazka.gcode'], ['g-demo-arcs', '/vrstvy/oblouky.gcode']]) {
    $<HTMLButtonElement>(id)?.addEventListener('click', (event) => {
      void loadSample(event.currentTarget as HTMLButtonElement, path);
    });
  }

  drop?.addEventListener('dragover', (event) => {
    event.preventDefault();
    drop.classList.add('is-over');
  });
  drop?.addEventListener('dragleave', (event) => {
    // dragleave also fires when crossing a child; only a real exit should drop the highlight
    if (!drop.contains(event.relatedTarget as Node | null)) drop.classList.remove('is-over');
  });
  drop?.addEventListener('drop', (event) => {
    event.preventDefault();
    drop.classList.remove('is-over');
    const file = event.dataTransfer?.files?.[0];
    if (file) handleFile(file);
  });
</script>

<style>
  .viewer {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 1px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }
  .viewer.is-over {
    border-color: var(--accent);
  }
  .controls {
    background: var(--bg);
    padding: 22px 20px;
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .stage {
    background: var(--panel);
  }
  .field {
    display: grid;
    gap: 6px;
  }
  .field > span {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dimmer);
  }
  .field input[type='file'] {
    background: var(--panel-2);
    border: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 12px;
    padding: 8px 10px;
    width: 100%;
  }
  .readout {
    display: grid;
    gap: 7px;
    margin: 0;
  }
  .readout > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--line-soft);
    padding-bottom: 6px;
  }
  .readout dt {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dimmer);
  }
  .readout dd {
    margin: 0;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink);
  }
  .demo {
    display: grid;
    gap: 10px;
    justify-items: start;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line-soft);
  }
  .demo p {
    margin: 0;
    font-size: 11px;
    line-height: 1.55;
    max-width: 42ch;
  }
  .demo p b {
    color: var(--ink);
    font-weight: 500;
  }
  .demo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .demo .btn[disabled] {
    opacity: 0.55;
    cursor: progress;
  }
  @media (max-width: 900px) {
    .viewer {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---

<Base
  title="Nástroje — převod souborů | Riplay"
  description="STL, OBJ, PLY, GLB mezi sebou a SVG ↔ DXF v milimetrech, v prohlížeči. Přetáhni soubor a stáhni ho v jiném formátu, nic se nenahrává."
>
  <section class="hero wrap">
    <p class="eyebrow">08 — nástroje · soubory</p>
    <h1 style="margin-top:18px">Soubor, který se <em>otevře</em>.</h1>
    <p class="lead">
      Někdo pošle model nebo kresbu a stroj to nepřečte. Přetáhni <b>STL, OBJ, PLY, GLB</b>
      nebo <b>SVG, DXF</b> a stáhni to v jiném formátu — převod běží v tvém prohlížeči,
      soubor se nikam nenahrává.
    </p>
    <div class="hero-meta mono">
      <span>3D: STL · OBJ · PLY · GLB</span><span>2D: SVG ↔ DXF</span><span>v milimetrech</span><span>zdarma</span>
    </div>
  </section>

  <section class="sheet wrap" id="nastroj">
    <div class="sheet-head">
      <h2>Převodník</h2>
      <span class="eyebrow">01 / soubor → soubor</span>
    </div>

    <div class="tool">
      <div class="tool-controls">
        <label class="field">
          <span>Model nebo kresba (STL / OBJ / PLY / GLB / SVG / DXF)</span>
          <input id="f-file" type="file" accept=".stl,.obj,.ply,.glb,.svg,.dxf" />
        </label>

        <div class="pair">
          <label class="field">
            <span>Převést na</span>
            <select id="f-target">
              <option value="stl">STL — binární, pro slicer a CAM</option>
              <option value="obj">OBJ — textový, pro CAD a vizualizaci</option>
              <option value="ply">PLY — textový, pro skenovací software</option>
              <option value="glb">GLB — pro web a 3D prohlížeče</option>
            </select>
          </label>
          <label class="field">
            <span>Měřítko (×)</span>
            <input id="f-scale" type="number" value="1" min="0.001" max="1000" step="0.001" />
          </label>
        </div>

        <p class="mono dim" id="f-state">zatím žádný soubor</p>
        <p class="mono" id="f-error" role="status" aria-live="polite"></p>
      </div>

      <div class="tool-preview" id="f-drop">
        <p class="mono dim" id="f-drop-hint">přetáhni soubor sem</p>

        <dl class="readout" id="m-readout" hidden>
          <div><dt>formát</dt><dd id="r-format">—</dd></div>
          <div><dt>trojúhelníků</dt><dd id="r-tris">—</dd></div>
          <div><dt>vrcholů</dt><dd id="r-verts">—</dd></div>
          <div><dt>rozměry</dt><dd id="r-size">—</dd></div>
          <div><dt>objem</dt><dd id="r-volume">—</dd></div>
        </dl>

        <dl class="readout" id="p-readout" hidden>
          <div><dt>formát</dt><dd id="q-format">—</dd></div>
          <div><dt>obrysů</dt><dd id="q-contours">—</dd></div>
          <div><dt>uzavřených</dt><dd id="q-closed">—</dd></div>
          <div><dt>bodů</dt><dd id="q-points">—</dd></div>
          <div><dt>rozměry</dt><dd id="q-size">—</dd></div>
        </dl>

        <p class="mono dim" id="q-notes" hidden></p>
      </div>
    </div>

    <div class="tool-actions">
      <button class="btn" id="b-download" type="button" disabled>Stáhnout</button>
      <span class="mono dim" id="f-out">vyber soubor</span>
    </div>
  </section>

  <section class="sheet wrap" id="co-neumi">
    <div class="sheet-head">
      <h2>Co to neumí</h2>
      <span class="eyebrow">02 / meze</span>
    </div>

    <div class="bench">
      <div class="bench-row"><b>PDF</b><span class="svc">formát</span><span class="state">ne — PDF je stránka, ne dráha; převod by byl obrázek</span><i class="dot warn"></i></div>
      <div class="bench-row"><b>Text v SVG</b><span class="svc">2D</span><span class="state">ne — musí být obrysy; text převeď nástrojem výš</span><i class="dot warn"></i></div>
      <div class="bench-row"><b>GLTF s externí .bin</b><span class="svc">3D</span><span class="state">ne — jeden soubor; .glb je v pořádku</span><i class="dot warn"></i></div>
      <div class="bench-row"><b>Materiály a textury</b><span class="svc">vzhled</span><span class="state">ne — zahazují se, zůstává geometrie</span><i class="dot warn"></i></div>
      <div class="bench-row"><b>Jednotky</b><span class="svc">měřítko</span><span class="state">3D soubor je nenese — proto je měřítko na tobě</span><i class="dot warn"></i></div>
    </div>

    <p class="dim" style="max-width:62ch;margin-top:22px">
      Všechny formáty čte a zapisuje tenhle web sám, bez cizí knihovny — žádná licence třetí
      strany a malá stránka. Trojúhelníky zůstávají trojúhelníky (quad se rozpustí na dva),
      materiály se ztratí. SVG se počítá podle <span class="mono">width</span> a
      <span class="mono">viewBox</span> do milimetrů; když rozměr chybí, bere se 1 jednotka
      jako 1 mm a nástroj to napíše. DXF se čte v jednotkách z hlavičky
      (<span class="mono">$INSUNITS</span>). Soubory nad 40 MB nástroj odmítne — větší model
      patří do sliceru, tady by zamrazil prohlížeč.
    </p>

    <p class="mono dim" style="margin-top:14px;display:flex;align-items:center;gap:8px">
      <Icon name="cam" size={14} />
      Písmo na dráhu najdeš v <a href="/nastroje/">druhém nástroji</a>.
    </p>
  </section>
</Base>

<style>
  .tool {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }
  .tool-controls {
    background: var(--bg);
    padding: 22px 20px;
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .tool-preview {
    background: var(--panel);
    border-left: 1px solid var(--line-soft);
    padding: 20px;
    display: grid;
    gap: 12px;
    align-content: start;
    min-height: 220px;
  }
  .tool-preview.dragging { outline: 1px dashed var(--accent); outline-offset: -6px; }
  .field { display: grid; gap: 6px; }
  .field > span {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dimmer);
  }
  .field input[type='number'],
  .field select,
  .field input[type='file'] {
    background: var(--panel-2);
    border: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 13px;
    padding: 9px 10px;
    width: 100%;
  }
  .field select { appearance: none; cursor: pointer; }
  .field input:focus-visible,
  .field select:focus-visible { outline: 1px solid var(--accent); outline-offset: 1px; }
  .field input[type='file']::file-selector-button {
    background: var(--panel);
    color: var(--ink);
    border: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    padding: 6px 10px;
    margin-right: 10px;
    cursor: pointer;
  }
  .field input[type='file']::file-selector-button:hover { border-color: var(--dim); }
  .pair { display: grid; grid-template-columns: 1.4fr 1fr; gap: 12px; }
  #f-error { color: var(--warn); min-height: 1em; margin: 0; }
  #f-state { margin: 0; }
  .readout { margin: 0; display: grid; gap: 0; border-top: 1px solid var(--line-soft); }
  /* `display: grid` beats the hidden attribute, so say it explicitly. */
  .readout[hidden] { display: none; }
  .readout > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .readout dt {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dimmer);
  }
  .readout dd { margin: 0; font-family: var(--mono); font-size: 12px; color: var(--ink); }
  #q-notes { margin: 0; line-height: 1.5; }
  #q-notes[hidden] { display: none; }
  .tool-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
  }
  .btn:disabled { border-color: var(--line); color: var(--dimmer); cursor: not-allowed; }
  .btn:disabled:hover { background: transparent; color: var(--dimmer); }
  @media (max-width: 880px) {
    .tool { grid-template-columns: 1fr; }
    .tool-preview { border-left: 0; border-top: 1px solid var(--line-soft); }
  }
</style>

<script>
  import {
    meshFrom, writeMesh, stats, scaleMesh, outputName, MAX_FILE_BYTES, tooLarge,
  } from '../../lib/mesh.mjs';
  import { pathsFrom, writePaths, pathStats } from '../../lib/paths2d.mjs';

  const $ = (id) => document.getElementById(id);
  const state = { name: null, kind: null, tris: null, contours: null };

  const TARGETS = {
    mesh: [
      ['stl', 'STL — binární, pro slicer a CAM'],
      ['obj', 'OBJ — textový, pro CAD a vizualizaci'],
      ['ply', 'PLY — textový, pro skenovací software'],
      ['glb', 'GLB — pro web a 3D prohlížeče'],
    ],
    paths: [
      ['dxf', 'DXF — pro frézku a laser'],
      ['svg', 'SVG — pro řezací a kreslicí programy'],
    ],
  };

  const number = (id, fallback) => {
    const value = parseFloat($(id).value);
    return Number.isFinite(value) && value > 0 ? value : fallback;
  };

  function setTargets(kind) {
    const select = $('f-target');
    select.replaceChildren(...TARGETS[kind].map(([value, label]) => {
      const option = document.createElement('option');
      option.value = value;
      option.textContent = label;
      return option;
    }));
  }

  function reset() {
    state.name = null;
    state.kind = null;
    state.tris = null;
    state.contours = null;
    $('b-download').disabled = true;
    $('m-readout').hidden = true;
    $('p-readout').hidden = true;
    $('q-notes').hidden = true;
    $('f-drop-hint').hidden = false;
    $('f-state').textContent = 'zatím žádný soubor';
    $('f-out').textContent = 'vyber soubor';
  }

  function showMesh(tris, format) {
    const s = stats(tris);
    $('r-format').textContent = format;
    $('r-tris').textContent = s.triangles.toLocaleString('cs-CZ');
    $('r-verts').textContent = s.vertices.toLocaleString('cs-CZ');
    $('r-size').textContent = s.size.map((v) => v.toFixed(2)).join(' × ');
    $('r-volume').textContent = s.volume >= 1000
      ? `${(s.volume / 1000).toFixed(2)} cm³`
      : `${s.volume.toFixed(2)} mm³`;
    $('m-readout').hidden = false;
  }

  function showPaths(contours, format, notes) {
    const s = pathStats(contours);
    $('q-format').textContent = format;
    $('q-contours').textContent = s.contours.toLocaleString('cs-CZ');
    $('q-closed').textContent = s.closed.toLocaleString('cs-CZ');
    $('q-points').textContent = s.points.toLocaleString('cs-CZ');
    $('q-size').textContent = `${s.size[0].toFixed(2)} × ${s.size[1].toFixed(2)} mm`;
    $('q-notes').hidden = !notes.length;
    $('q-notes').textContent = notes.join(' · ');
    $('p-readout').hidden = false;
  }

  function suggestTarget(kind, format) {
    if (kind === 'mesh') {
      const order = { 'stl-binary': 'obj', 'stl-ascii': 'obj', obj: 'stl', ply: 'stl', glb: 'stl' };
      $('f-target').value = order[format] ?? 'stl';
    } else {
      $('f-target').value = format === 'svg' ? 'dxf' : 'svg';
    }
  }

  function updateOutput() {
    if (!state.name) return;
    $('f-out').textContent = `→ ${outputName(state.name, $('f-target').value)}`;
  }

  async function load(file) {
    $('f-error').textContent = '';
    reset();
    state.name = file.name;

    // Refuse before reading: a 500 MB file would be in memory twice before any parser
    // could decide it is too big, which is exactly how a tab freezes.
    if (file.size > MAX_FILE_BYTES) {
      state.name = null;
      $('f-state').textContent = file.name;
      $('f-error').textContent = tooLarge(file.size);
      return;
    }

    $('f-state').textContent = `čtu ${file.name}…`;
    try {
      const bytes = new Uint8Array(await file.arrayBuffer());
      const is2d = /\.(svg|dxf)$/i.test(file.name);

      if (is2d) {
        const { format, contours, notes } = pathsFrom(file.name, bytes);
        state.kind = 'paths';
        state.contours = contours;
        setTargets('paths');
        showPaths(contours, format, notes);
        suggestTarget('paths', format);
      } else {
        const { tris, format } = meshFrom(file.name, bytes);
        state.kind = 'mesh';
        state.tris = tris;
        setTargets('mesh');
        showMesh(tris, format);
        suggestTarget('mesh', format);
      }

      $('b-download').disabled = false;
      $('f-state').textContent = `${file.name} — ${(file.size / 1024).toFixed(0)} kB`;
      $('f-drop-hint').hidden = true;
      updateOutput();
    } catch (error) {
      const name = file.name;
      reset();
      state.name = name;
      $('f-state').textContent = name;
      $('f-error').textContent = error.message;
    }
  }

  $('f-file').addEventListener('change', (event) => {
    const file = event.target.files?.[0];
    if (file) load(file);
  });

  $('f-target').addEventListener('change', updateOutput);

  $('b-download').addEventListener('click', () => {
    try {
      const target = $('f-target').value;
      const factor = number('f-scale', 1);
      const { bytes, mime } = state.kind === 'paths'
        ? writePaths(state.contours, target)
        : writeMesh(scaleMesh(state.tris, factor), target);

      const url = URL.createObjectURL(new Blob([bytes], { type: mime }));
      const link = document.createElement('a');
      link.href = url;
      link.download = outputName(state.name, target);
      link.click();
      URL.revokeObjectURL(url);
      $('f-error').textContent = '';
    } catch (error) {
      $('f-error').textContent = error.message;
    }
  });

  const drop = $('f-drop');
  for (const type of ['dragenter', 'dragover']) {
    drop.addEventListener(type, (event) => {
      event.preventDefault();
      drop.classList.add('dragging');
    });
  }
  for (const type of ['dragleave', 'drop']) {
    drop.addEventListener(type, () => drop.classList.remove('dragging'));
  }
  drop.addEventListener('drop', (event) => {
    event.preventDefault();
    const file = event.dataTransfer?.files?.[0];
    if (file) load(file);
  });
</script>

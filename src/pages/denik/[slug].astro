---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { isLive } from '../../lib/episodes';

// Only episodes the index also treats as live get a URL, so no page can exist that promises
// content it does not have.
export async function getStaticPaths() {
  const episodes = await getCollection('episodes', (episode) => isLive(episode));
  return episodes.map((episode) => ({ params: { slug: episode.id }, props: { episode } }));
}

const { episode } = Astro.props;
const { Content } = await render(episode);
const d = episode.data;
const stamp = d.date?.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={`${d.n} — ${d.title} · Riplay`} description={d.summary}>
  <section class="sheet wrap">
    <div class="sheet-head">
      <div>
        <p class="eyebrow">deník · {d.n}</p>
        <h1 style="margin-top:14px">{d.title}</h1>
      </div>
      {stamp && <span class="eyebrow">{stamp}</span>}
    </div>

    <p class="lead" style="max-width:64ch">{d.summary}</p>

    {d.machineConfig && (
      <p class="config mono">
        <span>stroj při téhle epizodě</span>
        {d.machineConfig}
      </p>
    )}

    <article class="prose">
      <Content />
    </article>

    <p class="mono dim" style="margin-top:44px">
      <a href="/denik/">← všechny epizody</a>
    </p>
  </section>
</Base>

<style>
  .config {
    margin-top: 26px;
    font-size: 11.5px;
    line-height: 1.7;
    color: var(--dim);
    border-left: 2px solid var(--line);
    padding-left: 14px;
    max-width: 72ch;
  }
  .config span {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 10px;
    color: var(--dimmer);
    margin-bottom: 3px;
  }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { isLive } from '../../lib/episodes';

// Published and planned differ by whether a page exists, so the row is an anchor only when
// `isLive` says one was generated — the same predicate the route uses.
const episodes = (await getCollection('episodes')).sort((a, b) =>
  a.data.n.localeCompare(b.data.n, 'cs', { numeric: true }),
);
const liveCount = episodes.filter(isLive).length;
---

<Base title="Deník stavby — Riplay" description="Epizody stavby pětiosé mašiny: co fungovalo, co ne, a co to stálo.">
  <section class="sheet wrap">
    <div class="sheet-head">
      <div>
        <p class="eyebrow">deník</p>
        <h1 style="margin-top:14px">Deník stavby</h1>
      </div>
      <span class="eyebrow">{liveCount} publikováno</span>
    </div>

    <p class="lead" style="max-width:62ch">
      Každá epizoda je datovaná podle konfigurace stroje, která ten den existovala. Nejsou to
      novinky, je to záznam.
    </p>

    <div class="eps">
      {episodes.map((e) => {
        const live = isLive(e);
        const Tag = live ? 'a' : 'div';
        return (
          <Tag class:list={['ep-row', { planned: !live }]} href={live ? `/denik/${e.id}/` : undefined}>
            <span class="mono dim">{e.data.n}</span>
            <div>
              <h2>{e.data.title}</h2>
              <p>{e.data.summary}</p>
            </div>
            <span class="mono dim">
              {live && e.data.date ? e.data.date.toLocaleDateString('cs-CZ') : 'připravujeme'}
            </span>
          </Tag>
        );
      })}
    </div>
  </section>
</Base>

<style>
  .eps {
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }
  .ep-row {
    display: grid;
    grid-template-columns: 70px 1fr auto;
    gap: 20px;
    align-items: start;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
  }
  .ep-row.planned {
    opacity: 0.6;
  }
  .ep-row h2 {
    font-size: 20px;
    margin: 0 0 6px;
  }
  a.ep-row:hover h2 {
    color: var(--accent);
  }
  .ep-row p {
    margin: 0;
    color: var(--dim);
    max-width: 62ch;
    font-size: 14.5px;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .ep-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>

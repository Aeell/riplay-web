---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { shop } from '../data/shop';

const stamp = new Intl.DateTimeFormat('cs-CZ', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Riplay — dílna, kterou si můžeš přehrát</title>
    <meta
      name="description"
      content="Jeden člověk, CAD, CNC frézování a 3D tisk. Díly na míru, které se nedají koupit — a u každého je vidět, jak vznikl."
    />
    <meta name="theme-color" content="#0b0b0c" />
    <meta property="og:title" content="Riplay — dílna, kterou si můžeš přehrát" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta
      property="og:description"
      content="Jeden člověk, CAD, CNC frézování a 3D tisk. Díly na míru, které se nedají koupit — a u každého je vidět, jak vznikl."
    />
    <meta property="og:image" content="https://riplay.cz/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Riplay — dílna, kterou si můžeš přehrát" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://riplay.cz/" />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <header class="top">
      <div class="wrap top-in">
        <a class="wordmark" href="/" aria-label="Riplay — úvod">
          <Mark size={21} />
          <span class="wm-txt"><b>RI</b>PLAY</span>
          <span class="live" aria-hidden="true"></span>
        </a>
        <nav class="nav" aria-label="Hlavní">
          <a href="#dilna">Dílna</a>
          <a href="#ponk">Na ponku</a>
          <a href="#denik">Deník</a>
          <a href="#zakazka">Zakázka</a>
        </nav>
        <a class="btn" href="#zakazka">Zadat díl →</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <span>
          Riplay · {shop.legal.name} ·
          {shop.legal.ico ? `IČO ${shop.legal.ico}` : <span class="gap">IČO doplní se</span>}
        </span>
        <span>{shop.legal.address}</span>
        <span>stav k {stamp} · stránka je otevřený zdroj</span>
      </div>
    </footer>
  </body>
</html>

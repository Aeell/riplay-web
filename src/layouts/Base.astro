---
import '../styles/global.css';
import { shop } from '../data/shop';

const stamp = new Intl.DateTimeFormat('cs-CZ', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Riplay — dílna, kterou si můžeš přehrát</title>
    <meta
      name="description"
      content="Jeden člověk, CAD, CNC frézování a 3D tisk. Díly na míru, které se nedají koupit — a u každého je vidět, jak vznikl."
    />
    <meta name="theme-color" content="#0b0b0c" />
    <meta property="og:title" content="Riplay — dílna, kterou si můžeš přehrát" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <link rel="canonical" href="https://riplay.cz/" />
  </head>
  <body>
    <header class="top">
      <div class="wrap top-in">
        <a class="wordmark" href="/"><span class="live"></span><b>RI</b>PLAY</a>
        <nav class="nav" aria-label="Hlavní">
          <a href="#dilna">Dílna</a>
          <a href="#ponk">Na ponku</a>
          <a href="#denik">Deník</a>
          <a href="#zakazka">Zakázka</a>
        </nav>
        <a class="btn" href="#zakazka">Zadat díl →</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <span>
          Riplay · {shop.legal.name} ·
          {shop.legal.ico ? `IČO ${shop.legal.ico}` : <span class="gap">IČO doplní se</span>}
        </span>
        <span>{shop.legal.address}</span>
        <span>stav k {stamp} · stránka je otevřený zdroj</span>
      </div>
    </footer>
  </body>
</html>

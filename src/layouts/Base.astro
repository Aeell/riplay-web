---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { shop } from '../data/shop';

const stamp = new Intl.DateTimeFormat('cs-CZ', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());

// Every page carries its own title/description; the home page values are the
// defaults so a new page cannot silently inherit the wrong one.
type Props = { title?: string; description?: string };
const {
  title = 'Riplay — dílna, kterou si můžeš přehrát',
  description = 'Jeden člověk, CAD, CNC frézování a 3D tisk. Díly na míru, které se nedají koupit — a u každého je vidět, jak vznikl.',
} = Astro.props;
// The static build writes directories, so Netlify answers /archiv with a 301 to
// /archiv/. A canonical that points at the redirecting URL is worse than none, so it
// is built from the URL that actually returns 200.
const route = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/$/, '')}/`;
const canonical = new URL(route, Astro.site).href;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0c" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://riplay.cz/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Riplay — dílna, kterou si můžeš přehrát" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <header class="top">
      <div class="wrap top-in">
        <a class="wordmark" href="/" aria-label="Riplay — úvod">
          <Mark size={21} />
          <span class="wm-txt"><b>RI</b>PLAY</span>
          <span class="live" aria-hidden="true"></span>
        </a>
        <nav class="nav" aria-label="Hlavní">
          <a href="/#dilna">Dílna</a>
          <a href="/#ponk">Na ponku</a>
          <a href="/#denik">Deník</a>
          <a href="/nastroje/">Nástroje</a>
          <a href="/archiv/">Archiv</a>
          <a href="/#zakazka">Zakázka</a>
        </nav>
        <a class="btn" href="/#zakazka">Zadat díl →</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <span>
          Riplay · {shop.legal.name} ·
          {shop.legal.ico ? `IČO ${shop.legal.ico}` : <span class="gap">IČO doplní se</span>}
        </span>
        <span>{shop.legal.address}</span>
        <span>
          <a href="/archiv/">archiv staré verze</a> ·
          <a href="https://github.com/Aeell/riplay-web">zdroj</a>
        </span>
        <span>stav k {stamp}</span>
      </div>
    </footer>
  </body>
</html>

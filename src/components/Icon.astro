---
/**
 * One glyph set for the whole site: 24 px grid, hairline stroke, no fills.
 * Icons are drawn, not imported — a dependency would drift from the design
 * language and this file is small enough to keep honest.
 */
type Name =
  | 'brief'
  | 'cad'
  | 'cam'
  | 'mill'
  | 'print'
  | 'done'
  | 'cnc'
  | 'assembly';

type Props = { name: Name; size?: number; class?: string };
const { name, size = 22, class: cls = '' } = Astro.props;

const paths: Record<Name, string> = {
  // zadání — a request arrives: document with a folded corner
  brief:
    'M6 3.5 H13.5 L18 8 V20.5 H6 Z M13.5 3.5 V8 H18 M9 12.2 H15 M9 15.8 H12.8',
  // CAD — isometric solid
  cad:
    'M12 3.2 L20.5 7.6 V16.4 L12 20.8 L3.5 16.4 V7.6 Z M3.5 7.6 L12 12 L20.5 7.6 M12 12 V20.8',
  // CAM — toolpath: closed loop with a lead-in move
  cam: 'M12 4.4 A7.6 7.6 0 1 1 4.4 12 M12 8.6 V15.4 M8.6 12 H15.4 M3 21 L7.6 16.4',
  // fréza — end mill entering the stock
  mill: 'M9.4 3 H14.6 V13.2 L12 16.2 L9.4 13.2 Z M4 20 H20 M10.8 6.4 H13.2',
  // tisk — nozzle and layers
  print: 'M8 3.5 H16 L14.2 9.6 H9.8 Z M12 9.6 V11.6 M4.6 14.8 H19.4 M4.6 18.2 H19.4 M7.8 21.4 H16.2',
  // hotovo — finished
  done: 'M12 3.8 A8.2 8.2 0 1 1 11.98 3.8 M8.2 12.1 L11 14.9 L16 9.4',
  // CNC — spindle over the bed, chips flying
  cnc: 'M3.8 6 H20.2 V18.4 H3.8 Z M3.8 12.2 H12.4 V6',
  // sestava — two plates fastened together
  assembly:
    'M4 6.5 H14 V11 H4 Z M10 13 H20 V17.5 H10 Z M7 8.7 H7.01 M17 15.2 H17.01 M12 13 V11',
};

const d = paths[name];
---

<svg
  class={`ico ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={d} />
</svg>

<style>
  .ico {
    display: block;
    flex: none;
  }
</style>

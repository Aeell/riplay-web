---
/**
 * The mark: a part (hairline circle) with a play glyph inside it.
 * "A part you can replay" in two shapes, so it survives being 16 px tall.
 * The circle inherits the text colour; the play glyph is the one accent.
 */
type Props = { size?: number; class?: string };
const { size = 22, class: cls = '' } = Astro.props;
---

<svg
  class={`mk ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="16" cy="16" r="12" fill="none" stroke="currentColor" stroke-width="1.6" />
  <path d="M12.6 10.6 L21.6 16 L12.6 21.4 Z" fill="var(--accent)" />
</svg>

<style>
  .mk {
    display: block;
    flex: none;
  }
</style>
